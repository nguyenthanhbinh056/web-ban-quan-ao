<%- include('partials/header', {title}) %>
<section class="hero"><div class="hero-copy"><p class="eyebrow">BỘ SƯU TẬP MỚI</p><h1>Mặc chất riêng.<br><em>Sống phong cách.</em></h1><p>Những thiết kế hiện đại cho phong cách mỗi ngày của bạn.</p><a class="btn btn-dark" href="/shop">Khám phá cửa hàng <span>↗</span></a></div><div class="hero-art"><div class="art-circle"></div><div class="art-label">NEW<br>SEASON<br>2026</div><div class="art-caption">STUDIO / EVERYDAY ESSENTIALS</div></div></section>
<section class="section-head"><div><p class="eyebrow">ĐƯỢC YÊU THÍCH</p><h2>Sản phẩm nổi bật</h2></div><a class="text-link" href="/shop">Xem tất cả ↗</a></section>
<div class="product-grid"><% products.forEach((p,i)=>{ %><a class="product-card" href="/product/<%= p.id %>"><div class="product-image tone-<%= i%4 %>"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>"><% }else{ %><span class="product-placeholder"><%= p.category.toUpperCase() %></span><% } %><span class="image-index">0<%= i+1 %></span></div><div class="product-meta"><div><h3><%= p.name %></h3><p><%= p.category %></p></div><strong><%= money(p.price) %></strong></div></a><% }) %></div>
<section class="service-strip"><div><strong>01 / Chất lượng</strong><span>Chọn lọc chất liệu kỹ lưỡng</span></div><div><strong>02 / Giao hàng</strong><span>Đặt hàng tiện lợi tại nhà</span></div><div><strong>03 / Phong cách</strong><span>Tự tin với chất riêng</span></div></section>
<%- include('partials/footer') %>
