<%- include('partials/header', {title}) %>
<div class="page-title compact"><p class="eyebrow">YOUR SELECTION</p><h1>Giỏ hàng</h1></div>
<% if(!items.length){ %><div class="empty"><h2>Giỏ hàng đang trống</h2><p>Chọn vài món đồ bạn yêu thích để bắt đầu nhé.</p><a href="/shop" class="btn btn-dark">Đến cửa hàng</a></div><% }else{ %><div class="cart-layout"><div class="cart-items"><% items.forEach(i=>{ %><div class="cart-row"><div class="mini-product tone-<%= i.product.id % 4 %>"><% if(i.product.image){ %><img src="<%= i.product.image %>" alt="<%= i.product.name %>"><% }else{ %><span><%= i.product.category %></span><% } %></div><div class="cart-description"><a href="/product/<%= i.product.id %>"><strong><%= i.product.name %></strong></a><span>Size <%= i.size %> · <%= i.color %></span><span><%= money(i.product.price) %></span></div><form action="/cart/update" method="post" class="qty-form"><input type="hidden" name="key" value="<%= i.key %>"><input type="number" name="qty" min="1" max="99" value="<%= i.qty %>"><button class="text-link">Cập nhật</button></form><form action="/cart/remove" method="post"><input type="hidden" name="key" value="<%= i.key %>"><button class="remove-button">Xóa</button></form><strong><%= money(i.subtotal) %></strong></div><% }) %></div><aside class="summary"><h2>Tóm tắt đơn hàng</h2><div class="summary-line"><span>Tạm tính</span><strong><%= money(total) %></strong></div><div class="summary-line"><span>Vận chuyển</span><span>Tính khi xác nhận</span></div><div class="summary-line total"><span>Tổng cộng</span><strong><%= money(total) %></strong></div><a href="/checkout" class="btn btn-dark btn-wide">Tiến hành thanh toán</a></aside></div><% } %>
<%- include('partials/footer') %>
