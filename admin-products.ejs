<%- include('partials/header', {title}) %><div class="page-title compact"><p class="eyebrow">CATALOG MANAGEMENT</p><h1>Quản lý sản phẩm</h1></div><div class="admin-form panel"><h2>Thêm sản phẩm mới</h2><form method="post" enctype="multipart/form-data" class="form-grid"><div><label>Tên sản phẩm</label><input name="name" required></div><div><label>Danh mục</label><input name="category" required placeholder="Áo, Quần..."></div><div><label>Giá (VND)</label><input name="price" type="number" min="0" required></div><div><label>Tồn kho mỗi biến thể</label><input name="stock" type="number" min="0" value="5"></div><div><label>Màu sắc (phân cách bằng dấu phẩy)</label><input name="colors" value="Đen,Trắng"></div><div><label>Ảnh sản phẩm</label><input name="image" type="file" accept="image/*"></div><div class="full"><label>Mô tả</label><textarea name="description" rows="2"></textarea></div><div class="full"><button class="btn btn-dark">Thêm sản phẩm</button></div></form></div><div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Biến thể / tồn kho</th><th>Thao tác</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><strong><%= p.name %></strong><br><small><%= p.active?'Đang bán':'Đã ẩn' %></small></td><td><%= p.category %></td><td><%= money(p.price) %></td><td><% p.variants.forEach((v,i)=>{ %><form action="/admin/products/<%= p.id %>/stock" method="post" class="stock-form"><span><%= v.size %> / <%= v.color %></span><input type="hidden" name="variantIndex" value="<%= i %>"><input name="stock" type="number" min="0" value="<%= v.stock %>"><button class="btn btn-small">Lưu</button></form><% }) %></td><td><% if(p.active){ %><form action="/admin/products/<%= p.id %>/delete" method="post" onsubmit="return confirm('Ẩn sản phẩm này khỏi cửa hàng?')"><button class="btn btn-danger btn-small">Ẩn sản phẩm</button></form><% } %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
