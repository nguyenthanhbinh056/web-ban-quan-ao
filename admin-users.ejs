<%- include('partials/header', {title}) %><div class="page-title compact"><p class="eyebrow">PEOPLE & ACCESS</p><h1>Quản lý tài khoản</h1></div><div class="panel admin-form"><h2>Tạo tài khoản</h2><form method="post" class="form-grid"><div><label>Họ tên</label><input name="name" required></div><div><label>Email</label><input type="email" name="email" required></div><div><label>Mật khẩu tạm (ít nhất 8 ký tự)</label><input type="password" name="password" minlength="8" required></div><div><label>Vai trò</label><select name="role"><option value="staff">Nhân viên</option><option value="customer">Khách hàng</option><option value="admin">Quản trị viên</option></select></div><div class="full"><button class="btn btn-dark">Tạo tài khoản</button></div></form></div><div class="table-wrap"><table><thead><tr><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= ({admin:'Admin',staff:'Nhân viên',customer:'Khách hàng'})[u.role] %></td><td><span class="status"><%= u.active?'Hoạt động':'Đã khóa' %></span></td><td><% if(u.id!==currentUser.id){ %><form method="post" action="/admin/users/<%= u.id %>/toggle"><button class="btn btn-small <%= u.active?'btn-danger':'' %>"><%= u.active?'Khóa':'Mở khóa' %></button></form><% }else{ %><small>Tài khoản hiện tại</small><% } %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
