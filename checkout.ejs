<%- include('partials/header', {title}) %><div class="page-title compact"><p class="eyebrow">ALMOST YOURS</p><h1>Thanh toán</h1></div><div class="checkout-layout"><form method="post" class="panel stack-form"><h2>Thông tin giao hàng</h2><label>Họ tên người nhận</label><input name="name" required value="<%= user.name %>"><label>Số điện thoại</label><input name="phone" required value="<%= user.phone %>" placeholder="09xxxxxxxx"><label>Địa chỉ giao hàng</label><textarea name="address" required rows="3"><%= user.address %></textarea><label>Phương thức thanh toán</label><label class="radio-row"><input type="radio" name="payment" value="COD" checked> Thanh toán khi nhận hàng (COD)</label><label class="radio-row"><input type="radio" name="payment" value="VietQR"> Chuyển khoản VietQR (cần xác nhận chuyển khoản)</label><label class="radio-row"><input type="radio" name="payment" value="EWallet"> Ví điện tử (demo, chưa tích hợp cổng thanh toán)</label><button class="btn btn-dark btn-wide">Xác nhận đặt hàng</button></form><aside class="summary"><h2>Đơn hàng của bạn</h2><% items.forEach(i=>{ %><div class="summary-line"><span><%= i.product.name %> × <%= i.qty %><small class="block"><%= i.size %> · <%= i.color %></small></span><strong><%= money(i.product.price*i.qty) %></strong></div><% }) %><div class="summary-line total"><span>Tổng cộng</span><strong><%= money(total) %></strong></div></aside></div><%- include('partials/footer') %>
