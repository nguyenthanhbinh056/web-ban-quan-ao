<%- include('partials/header', {title}) %>
<div class="auth-wrap"><div class="auth-aside"><p class="eyebrow">WELCOME TO STUDIO</p><h1><%= mode==='login'?'Phong cách bắt đầu từ đây.':'Tạo dấu ấn của riêng bạn.' %></h1><p>Những lựa chọn tinh giản, dành cho mỗi ngày khác biệt.</p><div class="auth-mark">S.</div></div><div class="auth-form"><p class="eyebrow"><%= mode==='login'?'YOUR ACCOUNT':'JOIN THE COMMUNITY' %></p><h2><%= mode==='login'?'Đăng nhập':'Tạo tài khoản' %></h2><form method="post" action="/<%= mode==='login'?'login':'register' %>" class="stack-form"><% if(mode==='register'){ %><label>Họ và tên</label><input name="name" required autocomplete="name" placeholder="Nguyễn Văn A"><% } %><label>Email</label><input name="email" type="email" required autocomplete="email" placeholder="you@example.com"><label>Mật khẩu</label><input name="password" type="password" required minlength="<%= mode==='register'?8:1 %>" autocomplete="<%= mode==='login'?'current-password':'new-password' %>" placeholder="••••••••"><button class="btn btn-dark btn-wide"><%= mode==='login'?'Đăng nhập':'Đăng ký tài khoản' %></button></form><p class="auth-switch"><%= mode==='login'?'Chưa có tài khoản?':'Đã có tài khoản?' %> <a href="/<%= mode==='login'?'register':'login' %>"><%= mode==='login'?'Đăng ký':'Đăng nhập' %></a></p><% if(mode==='login'){ %><div class="demo-login"><strong>Tài khoản demo</strong><span>Admin: admin@studio.local / Admin123!</span><span>Nhân viên: staff@studio.local / Staff123!</span><span>Khách: customer@studio.local / Customer123!</span></div><% } %></div></div>
<%- include('partials/footer') %>
