<%- include('partials/header', {title}) %><div class="page-title compact"><p class="eyebrow">STAFF WORKSPACE</p><h1>Điều phối đơn hàng</h1><p>Xin chào <%= currentUser.name %> — xử lý đơn và tra cứu tồn kho.</p></div><section class="section-head"><div><h2>Đơn hàng mới nhất</h2><p class="muted">Cập nhật trạng thái xử lý và theo dõi thanh toán.</p></div></section><% if(!orders.length){ %><div class="empty"><p>Chưa có đơn hàng nào.</p></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Mã đơn / Khách</th><th>Thông tin</th><th>Thanh toán</th><th>Tổng tiền</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td>#<%= o.id %><br><strong><%= o.customerName %></strong><br><small><%= o.phone %></small></td><td><%= o.items.map(i=>i.name+' ('+i.size+'/'+i.color+') × '+i.qty).join(', ') %><br><small><%= o.address %></small></td><td><% if(o.payment==='COD'){ %>Tiền mặt khi nhận (COD)<% }else if(o.payment==='VietQR'){ %>Chuyển khoản VietQR<% }else if(o.payment==='EWallet'){ %>Ví điện tử<% }else{ %>Chưa xác định<% } %><br><small><%= o.paymentStatus || (o.payment==='COD' ? 'Chưa thanh toán' : 'Chờ xác nhận') %></small></td><td><strong><%= money(o.total) %></strong></td><td><span class="status"><%= o.status %></span></td><td><form method="post" action="/staff/orders/<%= o.id %>/status" class="status-form"><select name="status"><% ['Chờ duyệt','Đã duyệt','Đang giao','Hoàn thành','Đã hủy'].forEach(s=>{ %><option <%= o.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn btn-small">Lưu</button></form></td></tr><% }) %></tbody></table></div><% } %><section class="section-head"><div><h2>Tra cứu tồn kho</h2><p class="muted">Nhân viên chỉ xem tồn kho, không thể chỉnh sửa sản phẩm.</p></div></section><div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Size</th><th>Màu</th><th>Tồn</th></tr></thead><tbody><% stock.forEach(p=>p.variants.forEach(v=>{ %><tr><td><%= p.name %></td><td><%= p.category %></td><td><%= v.size %></td><td><%= v.color %></td><td><%= v.stock %></td></tr><% })) %></tbody></table></div><%- include('partials/footer') %>
