<%- include('partials/header', {title}) %><div class="page-title compact"><p class="eyebrow">ORDER HISTORY</p><h1><%= staffView?'Quản lý đơn hàng':'Lịch sử đơn hàng' %></h1></div><% if(!orders.length){ %><div class="empty"><h2>Chưa có đơn hàng</h2><a href="/shop" class="btn btn-dark">Mua sắm ngay</a></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Sản phẩm</th><th>Thanh toán</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= new Date(o.createdAt).toLocaleString('vi-VN') %></td><td><%= o.items.map(i=>i.name+' × '+i.qty).join(', ') %></td><td><% if(o.payment==='COD'){ %>Tiền mặt khi nhận (COD)<% }else if(o.payment==='VietQR'){ %>Chuyển khoản VietQR<% }else if(o.payment==='EWallet'){ %>Ví điện tử<% }else{ %>Chưa xác định<% } %><br><small><%= o.paymentStatus || (o.payment==='COD' ? 'Chưa thanh toán' : 'Chờ xác nhận') %></small></td><td><strong><%= money(o.total) %></strong></td><td><span class="status"><%= o.status %></span></td></tr><% }) %></tbody></table></div><% } %><%- include('partials/footer') %>
